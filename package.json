{
  "name": "@kurone-kito/oc-knowledge-cache",
  "version": "0.1.0",
  "private": true,
  "description": "Experiment on non-volatile caching of knowledge using OpenClaw",
  "keywords": [
    "knowledge-cache",
    "ollama",
    "openclaw",
    "rag"
  ],
  "homepage": "https://github.com/kurone-kito/oc-knowledge-cache#readme",
  "bugs": "https://github.com/kurone-kito/oc-knowledge-cache/issues",
  "repository": "github:kurone-kito/oc-knowledge-cache",
  "license": "MIT",
  "author": "kurone-kito <krone@kit.black> (https://kit.black/)",
  "type": "module",
  "files": [],
  "scripts": {
    "clean": "rimraf -g \"*.tgz\" \"*.tsbuildinfo\" node_modules/.cache",
    "excel:convert": "node src/cli/excel-convert.mts",
    "kc:search": "node src/cli/kc-search.mts",
    "lint": "pnpm run --stream \"/lint:check:.+/\"",
    "lint:check:biome": "biome check",
    "lint:check:cspell": "cspell lint --show-suggestions .",
    "lint:check:markdown": "markdownlint-cli2 \"**/*.md\"",
    "lint:check:tsc": "tsc",
    "lint:fix": "pnpm run --stream \"/(lint:fix:.+|lint:check:cspell)/\"",
    "lint:fix:biome": "biome check --write",
    "lint:fix:markdown": "markdownlint-cli2 --fix \"**/*.md\"",
    "models:recommend": "node src/cli/models-recommend.mts",
    "nas:scan": "node src/cli/nas-scan.mts",
    "prepare": "husky",
    "test": "pnpm run lint && pnpm run test:unit",
    "test:unit": "node --test \"src/**/*.test.mts\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@cspell/cspell-types": "^10.3.6",
    "@kurone-kito/biome-config": "^0.23.0",
    "@kurone-kito/commitlint-config": "^0.23.0",
    "@kurone-kito/cspell-config": "^0.23.0",
    "@kurone-kito/lint-staged-config": "^0.23.0",
    "@kurone-kito/markdownlint-config": "^0.23.0",
    "@kurone-kito/typescript-config": "^0.22.0",
    "@types/node": "^26.6.4",
    "cspell": "^10.3.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.23.3",
    "rimraf": "^6.1.3",
    "typescript": "~7.0.2"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
  "engines": {
    "node": ">=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  }
}
